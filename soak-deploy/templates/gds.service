[Unit]
Description=F' soak-test GDS
After=network.target fprime-soak-fsw.service
Wants=fprime-soak-fsw.service

[Service]
Type=simple
User=__SERVICE_USER__
# fprime-gds reads command-line options from fprime-gds.yml in WorkingDirectory.
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/venv/bin/fprime-gds __GDS_ARGS__
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
